{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: events, the window's own getters and controls, and closing resources, which the page uses; not core:default, whose paths, images, menus, tray and webview the page never calls (row 27). Links open through the host's open_link. Add plugin permissions here only when a feature needs them.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:resources:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-request-user-attention",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "opener:allow-reveal-item-in-dir"
  ]
}
